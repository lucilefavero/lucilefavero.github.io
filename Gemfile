source "https://rubygems.org"

# Mirrors the exact Jekyll environment GitHub Pages uses to build the site.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby >= 3.0
gem "webrick"

# Stdlib gems that Jekyll 3.x expects but modern Ruby no longer bundles
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
